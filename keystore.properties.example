# Переименуйте в keystore.properties и заполните своими значениями.
# Сам файл keystore.properties в репозиторий не попадает — он в .gitignore.
#
# Хранилище создаётся один раз, этой командой (JDK лежит в Android Studio):
#   keytool -genkeypair -v -keystore meowculator.jks -storetype PKCS12 \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias meowculator
#
# Получившийся meowculator.jks и пароли к нему сохраните отдельно и надёжно:
# без них обновить уже опубликованное приложение невозможно, восстановить
# их нельзя ни через RuStore, ни через кого-либо ещё.

storeFile=meowculator.jks
storePassword=
keyAlias=meowculator
keyPassword=
